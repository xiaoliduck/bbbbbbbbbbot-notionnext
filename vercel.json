{
  "cleanUrls": false,
  "trailingSlash": false,
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[skip-version]\"*) exit 0;; *) exit 1;; esac",
  "headers": [],
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/notion-preview",
      "destination": "/archive",
      "permanent": false
    }
  ]
}